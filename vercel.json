{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://flowdesk-auth.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://flowdesk-backend-ji60.onrender.com/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "https://flowdesk-backend-ji60.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
